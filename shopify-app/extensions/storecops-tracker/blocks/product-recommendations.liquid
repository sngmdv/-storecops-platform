{% comment %}
  Storecops — product recommendations app block.

  A merchant drags this onto a product template in the Theme Editor. It
  asks the Storecops recommendation engine for products to pair with the
  one being viewed, then renders them as cards.

  Rendering is client-side because the recommendation set depends on the
  current visitor's history, which Liquid cannot see. The request goes
  through the app proxy, so no key is exposed.

  If the visitor has no history yet the engine falls back to the store's
  most-viewed products, so the block is never empty on a fresh install.
{% endcomment %}

{% assign heading = block.settings.heading | default: 'You may also like' %}
{% assign limit = block.settings.limit | default: 4 %}
{% assign show_price = block.settings.show_price %}
{% assign accent = block.settings.accent_color | default: '#08906C' %}

<div
  class="storecops-recs"
  id="storecops-recs-{{ block.id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ limit }}"
  data-proxy="{{ routes.root_url }}apps/storecops"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  hidden
>
  <h2 class="storecops-recs__heading">{{ heading }}</h2>
  <ul class="storecops-recs__list"></ul>
</div>

<style>
  #storecops-recs-{{ block.id }} {
    margin: 32px 0;
  }
  #storecops-recs-{{ block.id }} .storecops-recs__heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 16px;
  }
  #storecops-recs-{{ block.id }} .storecops-recs__list {
    display: grid;
    grid-template-columns: repeat({{ limit }}, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 749px) {
    #storecops-recs-{{ block.id }} .storecops-recs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  #storecops-recs-{{ block.id }} .storecops-recs__card {
    display: block;
    padding: 12px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  #storecops-recs-{{ block.id }} .storecops-recs__card:hover {
    border-color: {{ accent }};
  }
  #storecops-recs-{{ block.id }} .storecops-recs__name {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.4;
    margin-bottom: 4px;
  }
  #storecops-recs-{{ block.id }} .storecops-recs__price {
    display: block;
    font-size: 0.875rem;
    opacity: 0.75;
  }
  #storecops-recs-{{ block.id }} .storecops-recs__oos {
    display: block;
    font-size: 0.75rem;
    opacity: 0.6;
    margin-top: 2px;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('storecops-recs-{{ block.id }}');
    if (!root) return;

    var productId = root.getAttribute('data-product-id');
    var limit = root.getAttribute('data-limit') || 4;
    var proxy = root.getAttribute('data-proxy');
    var showPrice = {{ show_price | default: true }};
    var currency = root.getAttribute('data-currency') || 'USD';

    function money(amount) {
      try {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: currency
        }).format(amount);
      } catch (e) {
        return amount;
      }
    }

    function render(items) {
      var list = root.querySelector('.storecops-recs__list');
      list.innerHTML = '';

      items.forEach(function (item) {
        // Without a handle we cannot build a real product URL, so skip
        // rather than render a link that 404s.
        if (!item.handle || !item.name) return;

        var li = document.createElement('li');
        var card = document.createElement('a');
        card.className = 'storecops-recs__card';
        card.href = '/products/' + item.handle;

        var name = document.createElement('span');
        name.className = 'storecops-recs__name';
        name.textContent = item.name;
        card.appendChild(name);

        if (showPrice && item.price !== null && item.price !== undefined) {
          var price = document.createElement('span');
          price.className = 'storecops-recs__price';
          price.textContent = money(item.price);
          card.appendChild(price);
        }

        if (item.in_stock === false) {
          var oos = document.createElement('span');
          oos.className = 'storecops-recs__oos';
          oos.textContent = 'Sold out';
          card.appendChild(oos);
        }

        li.appendChild(card);
        list.appendChild(li);
      });

      // Only reveal the block if we actually have something to show.
      if (list.children.length > 0) root.removeAttribute('hidden');
    }

    var url = proxy + '/recommendations?limit=' + encodeURIComponent(limit);
    if (productId) url += '&product_id=' + encodeURIComponent(productId);

    fetch(url, { headers: { Accept: 'application/json' } })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (data && data.recommendations) render(data.recommendations);
      })
      .catch(function () {
        /* Recommendations are a bonus — never break the product page. */
      });
  })();
</script>

{% schema %}
{
  "name": "Storecops recommendations",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#08906C"
    }
  ]
}
{% endschema %}
