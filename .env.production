# ── Production Environment ──────────────────────────────────────────
# Copy this to .env on the server and fill in real values.
# Railway: set these in the Variables tab of your project dashboard.
#
# IMPORTANT: Never commit this file with real secrets to version control.
# Use Railway's environment variables or a secrets manager.

# ── Core Configuration ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Generate a strong random key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-a-strong-random-key

# Public URL — Railway assigns one like https://storecops-production.up.railway.app
# Set this AFTER first deploy once you know the URL
PUBLIC_URL=https://your-app.up.railway.app

# Default store
DEFAULT_STORE_ID=store_demo

# ── Email Configuration ─────────────────────────────────────────────
# Option 1: Console (logs emails to terminal — for testing only)
EMAIL_PROVIDER=console

# Option 2: Resend (recommended — free tier: 100 emails/day)
# Sign up at https://resend.com
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=noreply@yourdomain.com

# ── WhatsApp Configuration ──────────────────────────────────────────
# Option 1: Console (logs messages to terminal — for testing only)
WHATSAPP_PROVIDER=console

# Option 2: Meta WhatsApp Cloud API (recommended for production)
# Get credentials from Meta Business Manager → WhatsApp → API Setup
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=<from Meta Business Manager>
# WHATSAPP_PHONE_NUMBER_ID=<phone number ID>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<business account ID>
# WHATSAPP_APP_SECRET=<app secret>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-secret-string
# WHATSAPP_API_VERSION=v19.0

# ── Intelligence Tuning ─────────────────────────────────────────────
CHURN_INACTIVE_DAYS=30
FORECAST_WINDOW=7
COMPETITOR_SCRAPE_INTERVAL_HOURS=6

# ── Session & Auth ──────────────────────────────────────────────────
SESSION_TTL_DAYS=7

# ── Data Retention (days) ───────────────────────────────────────────
RETENTION_EVENTS_DAYS=365
RETENTION_DELIVERIES_DAYS=180
RETENTION_CONSENT_DAYS=730
RETENTION_MONITORING_DAYS=90
RETENTION_SESSIONS_DAYS=30

# ── Security ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Generate webhook secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_SECRET=replace-with-random-secret

# ── Payment (Optional) ──────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLIC_KEY=pk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay — https://dashboard.razorpay.com/access-keys
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# ── ROI Calculator ──────────────────────────────────────────────────
SUBSCRIPTION_COST=49
