# Core
PORT=4000
NODE_ENV=development

# API key required on all /api/v1 routes (X-API-Key header)
API_KEY=change-me-in-production

# Store identity used when no store context is supplied
DEFAULT_STORE_ID=store_demo

# Execution providers: console | real provider adapters can be plugged later
EMAIL_PROVIDER=console
WHATSAPP_PROVIDER=console

# ── WhatsApp Business API (Meta Cloud) ──────────────────────────────
# Set WHATSAPP_PROVIDER=meta and fill these to enable real WhatsApp delivery.
# Get these from the Meta Business Manager → WhatsApp → API Setup.
# WHATSAPP_ACCESS_TOKEN=<System User Token from Meta>
# WHATSAPP_PHONE_NUMBER_ID=<Phone Number ID>
# WHATSAPP_BUSINESS_ACCOUNT_ID=<Business Account ID>
# WHATSAPP_APP_SECRET=<App Secret for webhook signature verification>
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=<any string you choose — must match Meta config>
# WHATSAPP_API_VERSION=v19.0
#
# Optional: override default Meta template names per action type.
# WHATSAPP_TEMPLATE_RECOVERY_MESSAGE=cart_recovery
# WHATSAPP_TEMPLATE_CHECKOUT_NUDGE=checkout_reminder
# WHATSAPP_TEMPLATE_WINBACK_OFFER=winback_discount
# WHATSAPP_TEMPLATE_BROWSE_ABANDONMENT=browse_reminder
# WHATSAPP_TEMPLATE_VIP_SURPRISE=vip_thankyou

# ── Email (Resend) ──────────────────────────────────────────────────
# Set EMAIL_PROVIDER=resend and fill this to enable real email delivery.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=noreply@yourdomain.com

# Intelligence tuning
CHURN_INACTIVE_DAYS=30
FORECAST_WINDOW=7

# ── Competitor Intelligence ─────────────────────────────────────────
# Auto-scrape interval for competitor storefronts (hours). Default: 6.
# COMPETITOR_SCRAPE_INTERVAL_HOURS=6
#
# Meta Ad Library API — pull competitor ads from Facebook/Instagram.
# Get a long-lived token with ads_read permission from Meta Business Manager.
# META_AD_LIBRARY_TOKEN=<System User Token with ads_read>
# META_AD_LIBRARY_API_VERSION=v19.0

# ── Payment: Stripe (Global Customers) ──────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLIC_KEY=pk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Payment: Razorpay (Indian Customers — UPI, Net Banking, Wallets) ─
# Get keys from https://dashboard.razorpay.com/access-keys
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# ── GST Compliance (India) ──────────────────────────────────────────
# GSTIN=29AAACR5055R1Z0
# GST_RATE=18

# ── Refund & Subscription Policy ────────────────────────────────────
# REFUND_WINDOW_DAYS=14
# AUTO_RENEW_NOTICE_DAYS=7

# -- Data Retention (published in public/privacy.html section 4) ------
# Enforcement is OFF unless explicitly enabled. Nothing is deleted while
# RETENTION_ENABLED is unset. Take a backup first (see below).
# RETENTION_ENABLED=true
# RETENTION_INTERVAL_HOURS=24
# RETENTION_EVENTS_DAYS=365
# RETENTION_DELIVERIES_DAYS=180
# RETENTION_MONITORING_DAYS=90
# RETENTION_SESSIONS_DAYS=30
#
# Consent records are HELD by default: privacy.html retains them
# indefinitely, and a consent record is the evidence that we had permission
# to contact someone. Setting RETENTION_ENFORCE_CONSENT=true would delete
# them 730 days after creation, which contradicts the published policy --
# update the policy page at the same time if you ever enable this.
# RETENTION_ENFORCE_CONSENT=false
# RETENTION_CONSENT_DAYS=730

# -- Backups (SQLite) -------------------------------------------------
# STORAGE=sqlite persists to SQLITE_PATH. On Railway this directory MUST be a
# mounted volume, or a restart wipes the database.
# STORAGE=sqlite
# SQLITE_PATH=data/storecops.db
#
# npm run backup         -> consistent hot snapshot (VACUUM INTO) + verify
# npm run backup:verify  -> rehearse a restore through the real adapter
# Run these from a scheduled job, never from the web process.
# BACKUP_DIR=data/backups
# BACKUP_KEEP=7
