{
  "buildCommand": "npm install",
  "env": {
    "STORAGE": "memory",
    "NODE_ENV": "production"
  },
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/webhooks/:path*", "destination": "/api" },
    { "source": "/connect/:path*", "destination": "/api" },
    { "source": "/app", "destination": "/api" },
    { "source": "/audit", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/privacy", "destination": "/api" },
    { "source": "/terms", "destination": "/api" },
    { "source": "/support", "destination": "/api" },
    { "source": "/tracker-disclosure", "destination": "/api" }
  ]
}
