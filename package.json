{
  "name": "storecops-growth-platform",
  "version": "1.0.0",
  "description": "AI-driven e-commerce growth platform: customer intelligence, competitive monitoring, market trends and automated revenue generation in one unified 6-layer system.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint src/ test/ --ext .js",
    "lint:fix": "eslint src/ test/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\""
  },
  "keywords": [
    "ecommerce",
    "growth",
    "recovery",
    "intelligence",
    "saas"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "pdfkit": "^0.19.1",
    "stripe": "^14.0.0",
    "razorpay": "^2.9.0",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
