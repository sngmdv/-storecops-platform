# Normalise line endings.
#
# Without this, editing on Windows rewrites LF files as CRLF and every diff
# becomes unreviewable (git reports the whole file as changed). The repository
# is stored with LF; the working tree follows.
* text=auto eol=lf

# Never touch binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary

# Explicit, so these stay LF even if a tool disagrees.
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.liquid text eol=lf
*.sql   text eol=lf

# Windows-only helpers keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
